{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "json-rpc-2.0.schema.json",
  "title": "AiDEX JSON-RPC 2.0 message",
  "description": "Wire-envelope contract. Application method names and parameter schemas are defined by their owning service.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/notification" },
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/failure" }
  ],
  "$defs": {
    "id": { "type": ["string", "number", "null"] },
    "request": {
      "type": "object",
      "required": ["jsonrpc", "method", "id"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "type": "string", "minLength": 1 },
        "params": {},
        "id": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "notification": {
      "type": "object",
      "required": ["jsonrpc", "method"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "type": "string", "minLength": 1 },
        "params": {}
      },
      "additionalProperties": false
    },
    "success": {
      "type": "object",
      "required": ["jsonrpc", "result", "id"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "result": {},
        "id": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": ["jsonrpc", "error", "id"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "error": { "$ref": "#/$defs/error" },
        "id": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "integer" },
        "message": { "type": "string" },
        "data": {}
      },
      "additionalProperties": false
    }
  }
}
